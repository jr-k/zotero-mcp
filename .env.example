# Zotero MCP environment variables
# Copy this file to .env and fill in your configuration.

# Connection mode: local Zotero API (requires Zotero to be running)
# When set to true, read operations do not require credentials.
# ZOTERO_LOCAL=true

# Web API credentials
# These can also be set in local mode for hybrid access
# (local reads and Web API writes).
ZOTERO_API_KEY=your_api_key_here
ZOTERO_LIBRARY_ID=your_library_id_here

# Optional configuration (defaults to user)
# Personal library: user
# Group library: group
ZOTERO_LIBRARY_TYPE=user

# Local writes (requires Zotero 10 or newer)
# `zotero-mcp authorize-local` normally writes these values to the config file.
# These variables are useful in containers, CI, and other environments where
# using a config file is inconvenient.
# ZOTERO_LOCAL_API_KEY=local_api_key_here
# ZOTERO_LOCAL_SERVER_ID=server_id_here
# Set to false to force writes through the Web API (defaults to auto).
# ZOTERO_LOCAL_WRITE=auto

# OpenAI API key (optional, used for semantic search)
# OPENAI_API_KEY=your_openai_key_here
# OpenAI embedding model and optional Batch API indexing are configured via:
# zotero-mcp setup --semantic-config-only

# Google Gemini API key (optional)
# GEMINI_API_KEY=your_gemini_key_here

# Custom zotero.sqlite path (optional; local mode). When unset, the database
# is auto-detected from Zotero's configured data directory, then ~/Zotero.
# ZOTERO_DB_PATH=/path/to/Zotero/zotero.sqlite

# Docker Compose
# Port exposed by the HTTP MCP server
# MCP_PORT=8000
# Required in production. Generate one with: openssl rand -hex 32
# MCP_TOKEN=replace_with_a_secure_random_token
# In production, keep 127.0.0.1 when using a TLS-enabled reverse proxy.
# MCP_BIND_ADDRESS=127.0.0.1
# Image deployed by docker-compose.prod.yml
# ZOTERO_MCP_IMAGE=ghcr.io/jr-k/zotero-mcp:latest
